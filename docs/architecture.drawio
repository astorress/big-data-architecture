="1"><mxGeometry x="95" y="325" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-5" parent="bd-stream-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="BigDataLab (lab) · Python 3.13 · confluent-kafka · PySpark 4.2" vertex="1"><mxGeometry x="170" y="90" width="480" height="880" as="geometry" /></mxCell><mxCell id="bd-stream-6" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="176" y="94" width="24" height="24" as="geometry" /></mxCell><mxCell id="bd-stream-7" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="lessons/06, 07, 10" vertex="1"><mxGeometry x="230" y="350" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-8" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;" vertex="1"><mxGeometry x="300" y="320" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-9" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="Simulador de lecturas&lt;br&gt;(src/lab/simulator.py)" vertex="1"><mxGeometry x="450" y="150" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-10" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="520" y="120" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-11" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="Consumidores lección 06&lt;br&gt;grupos dashboard y billing" vertex="1"><mxGeometry x="450" y="350" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-12" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;" vertex="1"><mxGeometry x="520" y="320" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-13" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="Driver de Structured&lt;br&gt;Streaming (07 y 10)" vertex="1"><mxGeometry x="450" y="560" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-14" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;" vertex="1"><mxGeometry x="520" y="530" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-15" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="Tablero de operación&lt;br&gt;(lee meter-alerts)" vertex="1"><mxGeometry x="450" y="780" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-16" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓭&lt;/font&gt;" vertex="1"><mxGeometry x="520" y="750" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-17" parent="bd-stream-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Kafka 4.3 · KRaft (sin ZooKeeper) · apache/kafka:4.3.1" vertex="1"><mxGeometry x="720" y="90" width="520" height="880" as="geometry" /></mxCell><mxCell id="bd-stream-18" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="726" y="94" width="24" height="24" as="geometry" /></mxCell><mxCell id="bd-stream-19" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="BigDataKafka1&lt;br&gt;broker + controlador&lt;br&gt;localhost:19092" vertex="1"><mxGeometry x="775" y="150" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-20" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="845" y="120" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-21" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="BigDataKafka2&lt;br&gt;broker + controlador&lt;br&gt;localhost:19093" vertex="1"><mxGeometry x="945" y="150" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-22" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="1015" y="120" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-23" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="BigDataKafka3&lt;br&gt;broker + controlador&lt;br&gt;localhost:19094" vertex="1"><mxGeometry x="1115" y="150" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-24" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="1185" y="120" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-25" parent="bd-stream-common" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" value="&lt;b&gt;meter-readings&lt;/b&gt;&lt;br&gt;6 particiones × 3 réplicas · clave = meter_id&lt;br&gt;retención 7 días · min.insync.replicas = 2" vertex="1"><mxGeometry x="750" y="380" width="460" height="90" as="geometry" /></mxCell><mxCell id="bd-stream-26" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;" vertex="1"><mxGeometry x="1190" y="350" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-27" parent="bd-stream-common" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" value="&lt;b&gt;meter-alerts&lt;/b&gt;&lt;br&gt;3 particiones × 3 réplicas · clave = meter_id&lt;br&gt;una alerta por medidor y hora" vertex="1"><mxGeometry x="750" y="740" width="460" height="90" as="geometry" /></mxCell><mxCell id="bd-stream-28" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓬&lt;/font&gt;" vertex="1"><mxGeometry x="1190" y="710" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-29" parent="bd-stream-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Hadoop 3.5 · YARN + HDFS (detalle en la página batch)" vertex="1"><mxGeometry x="1290" y="90" width="590" height="880" as="geometry" /></mxCell><mxCell id="bd-stream-30" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="1296" y="94" width="24" height="24" as="geometry" /></mxCell><mxCell id="bd-stream-31" parent="bd-stream-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;" value="Ejecutores de Spark&lt;br&gt;en YARN (worker1, worker2)" vertex="1"><mxGeometry x="1360" y="400" width="72" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-32" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;" vertex="1"><mxGeometry x="1440" y="300" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-33" parent="bd-stream-common" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="/checkpoints/07, /10&lt;br&gt;offsets + estado" vertex="1"><mxGeometry x="1640" y="150" width="60" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-34" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt;" vertex="1"><mxGeometry x="1700" y="120" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-35" parent="bd-stream-common" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="/datalake/bronze/&lt;br&gt;readings_stream (Parquet)" vertex="1"><mxGeometry x="1640" y="400" width="60" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-36" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt;" vertex="1"><mxGeometry x="1700" y="370" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-37" parent="bd-stream-common" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="/models/hourly_kwh&lt;br&gt;+ silver/gold (catálogo, clima)" vertex="1"><mxGeometry x="1640" y="650" width="60" height="72" as="geometry" /></mxCell><mxCell id="bd-stream-38" parent="bd-stream-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓫&lt;/font&gt;" vertex="1"><mxGeometry x="1700" y="620" width="48" height="52" as="geometry" /></mxCell><mxCell id="bd-stream-39" edge="1" parent="bd-stream-common" source="bd-stream-3" target="bd-stream-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd-stream-40" edge="1" parent="bd-stream-common" source="bd-stream-7" target="bd-stream-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="368" /><mxPoint x="380" y="186" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-41" edge="1" parent="bd-stream-common" source="bd-stream-7" target="bd-stream-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd-stream-42" edge="1" parent="bd-stream-common" source="bd-stream-7" target="bd-stream-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="404" /><mxPoint x="380" y="596" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-43" edge="1" parent="bd-stream-common" source="bd-stream-7" target="bd-stream-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.95;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="418" /><mxPoint x="360" y="816" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-44" edge="1" parent="bd-stream-common" source="bd-stream-9" target="bd-stream-25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="186" /><mxPoint x="650" y="425" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-45" edge="1" parent="bd-stream-common" source="bd-stream-25" target="bd-stream-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="452" /><mxPoint x="620" y="386" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-46" edge="1" parent="bd-stream-common" source="bd-stream-25" target="bd-stream-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd-stream-47" edge="1" parent="bd-stream-common" source="bd-stream-13" target="bd-stream-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="596" /><mxPoint x="1330" y="458" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-48" edge="1" parent="bd-stream-common" source="bd-stream-31" target="bd-stream-33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="418" /><mxPoint x="1560" y="186" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-49" edge="1" parent="bd-stream-common" source="bd-stream-31" target="bd-stream-35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd-stream-50" edge="1" parent="bd-stream-common" source="bd-stream-37" target="bd-stream-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="686" /><mxPoint x="1560" y="454" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-51" edge="1" parent="bd-stream-common" source="bd-stream-31" target="bd-stream-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1396" y="785" /></Array></mxGeometry></mxCell><mxCell id="bd-stream-52" edge="1" parent="bd-stream-common" source="bd-stream-27" target="bd-stream-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd-stream-info" parent="bd-stream-0" value="bd-stream-info" /><mxCell id="bd-stream-53" parent="bd-stream-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Streaming: Kafka y Spark Structured Streaming&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;El mismo caso de los medidores, ahora en tiempo real: las lecturas entran a Kafka a medida que ocurren y Spark las procesa en micro-lotes. Los ejecutores corren en el mismo clúster YARN de la página batch y guardan su estado en el mismo HDFS.&lt;/p&gt;&lt;p&gt;El &lt;b&gt;Desarrollador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; ejecuta las &lt;b&gt;lecciones&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt; 06, 07 y 10. El &lt;b&gt;Simulador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; reproduce un día de lecturas como si llegaran en vivo: cada intervalo de 15 minutos de los 1.000 medidores se envía de golpe, con acks=all para que cada mensaje quede confirmado en varios brokers.&lt;/p&gt;&lt;p&gt;Los tres &lt;b&gt;brokers&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; de Kafka son también controladores (KRaft): votan entre ellos quién lleva los metadatos del clúster, sin ZooKeeper. El tema &lt;b&gt;meter-readings&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; se reparte en 6 particiones con una réplica en cada broker; la clave es el medidor, así sus lecturas siempre caen en la misma partición y en orden. Con min.insync.replicas = 2, un mensaje confirmado sobrevive a la caída de un broker.&lt;/p&gt;&lt;p&gt;En la lección 06, dos &lt;b&gt;grupos de consumidores&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt; (dashboard y billing) leen el mismo tema de forma independiente, cada uno con sus propios offsets, y se reparten las particiones entre sus miembros. Leer no borra nada: los mensajes viven 7 días y se pueden releer desde una hora dada.&lt;/p&gt;&lt;p&gt;En las lecciones 07 y 10, el &lt;b&gt;driver de Structured Streaming&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; define la consulta y los &lt;b&gt;ejecutores de Spark en YARN&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt; leen meter-readings en micro-lotes. Las ventanas se calculan con la hora de la lectura y un watermark de 15 minutos decide cuándo cerrarlas; las lecturas que llegan más tarde se descartan. Los &lt;b&gt;checkpoints en HDFS&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt; guardan los offsets de Kafka y el estado de las agregaciones: si la consulta se detiene, retoma donde quedó sin perder ni duplicar.&lt;/p&gt;&lt;p&gt;La lección 07 archiva cada lectura en el &lt;b&gt;data lake&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt; como Parquet (zona bronze) y suma el consumo por circuito y hora. La lección 10 carga el &lt;b&gt;modelo de la lección 08&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓫&lt;/font&gt; y el catálogo de medidores y el clima desde HDFS, pronostica el consumo de cada medidor y hora, aplica reglas (corte, consumo anómalo, medidor que deja de registrar) y escribe cada alerta en el tema &lt;b&gt;meter-alerts&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓬&lt;/font&gt;. El &lt;b&gt;tablero de operación&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓭&lt;/font&gt;, otro consumidor de Kafka, las muestra en vivo.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1940" y="40" width="600" height="630" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>