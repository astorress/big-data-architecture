# Spark: los trabajos corren en YARN; con SPARK_MASTER=local[*] corren solo dentro de este contenedor
SPARK_MASTER=yarn
SPARK_CONF_DIR=/app/.docker/spark
PYSPARK_PYTHON=/usr/local/bin/python
# PySpark ya está instalado en los nodos: los ejecutores lo importan de ahí en lugar de recibirlo comprimido
PYSPARK_ARCHIVES_PATH=local:/usr/local/lib/python3.13/site-packages
# HDFS y YARN: la CLI (hdfs, yarn, mapred) lee la configuración de HADOOP_CONF_DIR=/hadoop/conf
HDFS_URL=hdfs://master:8020
NAMENODE_HTTP=http://master:9870
RESOURCEMANAGER_HTTP=http://master:8088
HADOOP_ROOT_LOGGER=WARN,console
# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
