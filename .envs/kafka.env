# Cada broker es también controlador (KRaft): los tres votan quién lidera los metadatos del clúster
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka1:9093,2@kafka2:9093,3@kafka3:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:19092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
CLUSTER_ID=I7naqPwCRMW2i7UX3o_y2w
KAFKA_LOG_DIRS=/var/lib/kafka/data
# Valores por defecto de los temas: 3 particiones, 3 réplicas y al menos 2 sincronizadas para aceptar acks=all
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
# Los temas se crean a propósito (lección 06), no al escribir en uno que no existe
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_HEAP_OPTS=-Xmx256m -Xms256m
